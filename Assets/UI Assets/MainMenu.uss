.settings-button {
}

.crosshair {
    font-size: 28px;
    color: rgb(230, 245, 245);
    -unity-text-align: middle-center;
}

.crosshair.crosshair-voxel {
    color: rgb(179, 236, 222);
}

.crosshair.crosshair-extract {
    color: rgb(179, 236, 222);
}
